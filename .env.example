# Tự chạy npm run setup; không chia sẻ .env thật.
OFFICE_USER=admin
OFFICE_PASSWORD=
PORT=3010
HOST=127.0.0.1
AI_OFFICE_PROVIDERS=codex
AI_OFFICE_ACCOUNT_LABEL=AI của tôi
# Drive tùy chọn: tự cấu hình rclone riêng, không kèm cấu hình người khác.
AI_OFFICE_DRIVE_REMOTE=
# Chỉ cho worker từ xa: địa chỉ HTTPS gốc của server (để trống = server trên cùng máy).
AI_OFFICE_SERVER_URL=
# Tên máy hiển thị trong Máy xử lý (để trống = hostname).
AI_OFFICE_MACHINE_NAME=
